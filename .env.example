# 이 파일을 복사해서 .env로 만들고 값을 채운다. (.env는 git에 커밋되지 않는다)
#   cp .env.example .env

# ChromaDB 영속 데이터 저장 경로 (PersistentClient가 이 경로에 파일을 쓴다)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=ict_reports

# 업로드된 PDF 원본을 임시로 저장하는 경로
UPLOAD_DIR=./data/uploads

# fastembed가 다운로드하는 임베딩 모델 캐시 경로 (최초 실행 시 수 GB 다운로드됨)
FASTEMBED_CACHE_DIR=./.fastembed_cache

# 임베딩 모델: BAAI/bge-m3 (1024차원).
# fastembed 0.8.0에는 내장되어 있지 않아 app/core/embedding.py에서 add_custom_model()로
# 커스텀 등록해서 쓴다 (BAAI 공식 저장소의 onnx/model.onnx + onnx/model.onnx_data 사용).
# 최초 실행 시 약 2.27GB를 FASTEMBED_CACHE_DIR에 다운로드한다.
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 청킹 기준선 (CLAUDE.md 기준선: 600자 / overlap 100자)
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# 검색 결과 최상위 distance가 이 값을 넘으면 "관련 문서를 찾을 수 없습니다"로 응답한다.
# bge-m3 실측(실제 한글 리포트 1건, 질문 6개) 기준 관련 질문은 0.24~0.27, 무관한 질문은
# 0.53~0.62였다. 그 사이값인 0.45로 설정 — 문서가 다양해지면 재측정해서 조정할 것.
SEARCH_DISTANCE_THRESHOLD=0.45
