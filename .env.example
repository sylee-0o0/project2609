# 이 파일을 복사해서 .env로 만들고 값을 채운다. (.env는 git에 커밋되지 않는다)
#   cp .env.example .env

# ChromaDB 영속 데이터 저장 경로 (PersistentClient가 이 경로에 파일을 쓴다)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=ict_reports

# 업로드된 PDF 원본을 임시로 저장하는 경로
UPLOAD_DIR=./data/uploads

# fastembed가 다운로드하는 임베딩 모델 캐시 경로 (최초 실행 시 수 GB 다운로드됨)
FASTEMBED_CACHE_DIR=./.fastembed_cache

# ⚠️ 임베딩 모델: 아직 미확정.
# CLAUDE.md는 BAAI/bge-m3(1024차원)를 지정했지만, fastembed 0.8.0의
# TextEmbedding.list_supported_models()에 BAAI/bge-m3가 없는 것을 확인했다.
# CLAUDE.md 규칙("지원하지 않으면 진행을 멈추고 재논의한다. 임의로 다른 모델을 고르지 않는다")에 따라
# 사용자와 대체 모델을 다시 논의하기 전까지는 비워둔다.
EMBEDDING_MODEL_NAME=

# 청킹 기준선 (CLAUDE.md 기준선: 600자 / overlap 100자)
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# 검색 결과 최상위 distance가 이 값을 넘으면 "관련 문서를 찾을 수 없습니다"로 응답한다. (1-B에서 사용)
SEARCH_DISTANCE_THRESHOLD=0.8
